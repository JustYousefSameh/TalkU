[Unit]
Description=TalkU WireGuard daemon
Documentation=https://github.com/JustYousefSameh/TalkU
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The daemon is self-contained: the pinned wstunnel client is linked into
# talku-cli, so /opt/talku only needs this one executable.
ExecStart=/opt/talku/talku-cli daemon
# Best-effort tunnel teardown if the daemon dies without running `down`.
ExecStopPost=-/opt/talku/talku-cli down
Restart=on-failure
RestartSec=2s

# The daemon runs as root (it configures the WireGuard interface) with the
# `talku` group so the desktop app, whose user is a member, can reach the
# control socket in /run/talku and read/write the cached config in /var/lib/talku.
Group=talku
RuntimeDirectory=talku
RuntimeDirectoryMode=0755
StateDirectory=talku
StateDirectoryMode=2770

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
