{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalkU",
  "version": "0.1.0",
  "identifier": "com.p0wer.talku",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TalkU",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "width": 450,
        "height": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/talku-cli",
      "binaries/wstunnel"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
