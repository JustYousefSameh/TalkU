{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalkU",
  "version": "3.1.0",
  "identifier": "com.p0wer.talku",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TalkU",
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "width": 450,
        "height": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/opt/talku/talku-cli": "binaries/talku-cli-x86_64-unknown-linux-gnu",
          "/lib/systemd/system/talku-cli.service": "../linux/talku-cli.service",
          "/etc/NetworkManager/conf.d/99-talku-unmanaged.conf": "../linux/99-talku-unmanaged.conf"
        },
        "postInstallScript": "../linux/postinst.sh",
        "preRemoveScript": "../linux/prerm.sh",
        "postRemoveScript": "../linux/postrm.sh"
      },
      "rpm": {
        "files": {
          "/opt/talku/talku-cli": "binaries/talku-cli-x86_64-unknown-linux-gnu",
          "/usr/lib/systemd/system/talku-cli.service": "../linux/talku-cli.service",
          "/etc/NetworkManager/conf.d/99-talku-unmanaged.conf": "../linux/99-talku-unmanaged.conf"
        },
        "postInstallScript": "../linux/postinst.sh",
        "preRemoveScript": "../linux/prerm.sh",
        "postRemoveScript": "../linux/postrm.sh"
      }
    },
    "resources": {
      "resources/*": "resources/"
    },
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
